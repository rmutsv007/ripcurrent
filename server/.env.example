# ===== ตัวอย่างไฟล์ environment สำหรับ backend (server/) =====
# คัดลอกเป็นไฟล์ .env แล้วแก้ค่าให้เหมาะกับแต่ละ environment
# คำสั่ง: cp .env.example .env

# โหมดการทำงาน: development | production
# ถ้าเป็น production จะบังคับให้ตั้ง JWT_SECRET ไม่งั้นเซิร์ฟเวอร์จะไม่สตาร์ท
NODE_ENV=development

# พอร์ตของ backend (ค่าเริ่มต้น 4000)
PORT=4000

# กุญแจลับสำหรับเซ็น/ตรวจสอบ JWT — "ต้อง" ตั้งค่าใน production
# แนะนำให้สุ่มค่ายาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# รายชื่อ origin ของ frontend ที่อนุญาตให้เรียก API (คั่นหลายค่าด้วย comma)
# ค่าเริ่มต้น: http://localhost:3000,https://map.surveywms.com
CORS_ORIGIN=http://localhost:3000,https://map.surveywms.com

# บัญชี admin เริ่มต้น (ใช้กับสคริปต์ init-admin.js เท่านั้น)
# อย่าใช้ค่าเริ่มต้นใน production และเปลี่ยนรหัสผ่านหลังสร้างเสร็จ
ADMIN_USER=admin
ADMIN_PASS=admin1234
